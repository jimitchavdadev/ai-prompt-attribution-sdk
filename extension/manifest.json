{
  "manifest_version": 3,
  "name": "AI Prompt Attribution & Discovery Tracker",
  "version": "1.0.0",
  "description": "Transparent, consent-based attribution linking AI prompts to discovered source websites and citations.",
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Attribution Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/destination_script.js"],
      "run_at": "document_start"
    }
  ]
}
